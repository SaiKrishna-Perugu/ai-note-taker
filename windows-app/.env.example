# Create a key in Google AI Studio. Never commit your real .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ALM_LLM_PROVIDER=aistudio
# Alternatively: vertex_express uses GEMINI_API_KEY with Vertex AI Express mode.
# vertex_adc uses Google Application Default Credentials, PROJECT_ID and LOCATION.
# PROJECT_ID=your-google-cloud-project
# LOCATION=global
